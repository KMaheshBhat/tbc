{
  "name": "tbc-frameworx-monorepo",
  "version": "0.4.2",
  "description": "Monorepo for TBC FRAMEWORX",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "cli:test": "bun run --filter='@tbc-frameworx/tbc-cli' --concurrency=1 test",
    "cli:build": "bun run --filter='@tbc-frameworx/tbc-cli' build",
    "cli:install": "bun run cli:build && cd apps/tbc-cli && bun link",
    "all:build": "bun run scripts/build-all.ts --test",
    "all:build-fresh": "bun run scripts/build-all.ts --clean --test",
    "all:build-dist": "bun run scripts/build-all.ts --clean --dist --test",
    "node_modules:clean": "shx rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "shx": "^0.4.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "module": "index.ts",
  "type": "module"
}
